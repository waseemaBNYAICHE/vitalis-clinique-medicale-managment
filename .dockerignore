# Root-level ignore. Each build context also has its own .dockerignore
# (backend/.dockerignore, frontend/.dockerignore) which is what Docker actually
# applies for those builds.
.git
.gitignore
.github
.idea
.vscode

.env
.env.*
!.env.example

**/node_modules
**/vendor
**/dist
**/.DS_Store

docker-compose.override.yml
README.md
