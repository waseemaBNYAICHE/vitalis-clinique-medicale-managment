# Copy to .env to override the defaults baked into docker-compose.yml.
#   cp .env.example .env
# Everything here has a working default, so `docker compose up --build -d`
# succeeds without this file. Never commit the resulting .env.

COMPOSE_PROJECT_NAME=anas

# ---------------------------------------------------------------- Host ports
NGINX_PORT=8000
VITE_PORT=5173

# ---------------------------------------------------------------- PostgreSQL
# Not published to the host - reachable only from inside the compose network.
DB_DATABASE=laravel
DB_USERNAME=laravel
# Local development placeholder. Replace it in your own .env and use a secret
# manager anywhere that is not your laptop.
DB_PASSWORD=secret

# ---------------------------------------------------------------- Laravel
APP_ENV=local
APP_DEBUG=true
# APP_KEY is generated inside the container on first boot into backend/.env.
RUN_MIGRATIONS=true

# ---------------------------------------------------------------- Frontend
VITE_API_URL=http://localhost:8000/api

# ---------------------------------------------------------------- File owner
# Linux/macOS: set to your own ids (`id -u` / `id -g`) so bind-mounted files
# stay writable. Ignored on Docker Desktop for Windows.
UID=1000
GID=1000
